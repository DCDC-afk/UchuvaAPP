<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1115"
    tools:context=".MainActivity">

    <!-- BARRA SUPERIOR DE TELEMETRÍA -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1C1917"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="#5D4037"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INMADURAS"
                    android:textColor="#BCAAA4"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvInmaduras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#A5D6A7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MADURAS"
                    android:textColor="#BCAAA4"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvMaduras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#D36D42"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL"
                    android:textColor="#BCAAA4"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.uchuvatwinapp.MapaDigitalView
            android:id="@+id/mapaDigital"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- TARJETA FLOTANTE DE DETALLE LIMPIA -->
        <LinearLayout
            android:id="@+id/panelDetalleUchuva"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDetalleId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="UCHUVA ID: #101"
                android:textColor="#FFF59D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="ESTADO: MADURO"
                android:textColor="#D36D42"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleConfianza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="CONFIANZA YOLO: 95.0%"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDetalleCoordenadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="POSICIÓN: X=0.00m | Y=1.25m"
                android:textColor="#8B949E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDetalleFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="FRAME VIDEO: #45"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- MENÚ LATERAL -->
        <LinearLayout
            android:id="@+id/panelMenuLateral"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:orientation="vertical"
            android:background="#1A1D24"
            android:elevation="8dp"
            android:translationX="-280dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOTES PROCESADOS"
                android:textColor="#D36D42"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:background="#0F1115"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#2A2F3A" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListaMenuLotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleLotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:backgroundTint="#D36D42"
            android:textColor="#000000"
            android:text="☰ LOTES"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="10dp"
            android:fontFamily="monospace" />

    </FrameLayout>
</LinearLayout>