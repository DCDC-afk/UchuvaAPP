<?xml version="1.0" encoding="utf-8"?>
<!-- item_menu_lote.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#111D14"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#2E4F37"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Carpeta Lote"
            android:src="@drawable/ic_folder_uchuva" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreLoteMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="LOTE 1"
                android:textColor="#A5D6A7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDetallesLote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="Contenido: 3 videos  |  Tamaño: 69 MB"
                android:textColor="#E0F2E1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- NUEVO: FECHA DE CREACIÓN EN VERDE -->
        <TextView
            android:id="@+id/tvFechaLoteMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="monospace"
            android:text="2026/06/02 - 14:30 pm"
            android:textColor="#A5D6A7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="›"
            android:textColor="#4A7A59"
            android:textSize="22sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>