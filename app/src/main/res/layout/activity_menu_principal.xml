<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMenuPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background">

    <!-- 1. IMAGEN DE FONDO LIMPIA -->
    <ImageView
        android:id="@+id/imgAnimacionUchuva"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_uchuva_pixel"
        android:contentDescription="Imagen de Fondo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. SOMBRA DEGRADADA ÚNICAMENTE EN LA FRANJA INFERIOR -->
    <View
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_gradient_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. ENCABEZADO SUPERIOR: TÍTULO GRANDE + RECUADRO DE ESTADO -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TÍTULO GRANDE E IMPACTANTE -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="UCHUVA TWIN APP"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- RECUADRO DESTACADO PARA "ONLINE" -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC1A1D24"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/tech_success"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/tech_success"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ONLINE"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/tech_success"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 4. BOTONES FLOTANTES EN TONO NARANJA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Botón 1: Módulo Dron (Sólido Naranja) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModuloDron"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="CONTROL DRON"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="8dp"
            app:elevation="6dp" />

        <!-- Botón 2: Módulo Análisis Campo (Borde Naranja) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModuloAnalisis"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="GEMELO DIGITAL"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:elevation="6dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>